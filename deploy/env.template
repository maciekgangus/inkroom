# Copy to .env next to docker-compose.yml on the server and fill in. Never commit the real one.

# The token of the Cloudflare tunnel (Zero Trust, Networks, Tunnels, your tunnel, "Install and
# run a connector": the long string after `--token`).
TUNNEL_TOKEN=

# The keys of the registration captcha (Cloudflare dashboard, Turnstile, a widget for your domain).
# Without TURNSTILE_SECRET registration is closed.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Signing in with Google (R-063, deploy/README.md section 8). Without both the client ID and the
# secret the Google button is hidden. PUBLIC_URL is the address of the site.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=https://inkroom.lesniakmaciek.dev

# Which image to run. Leave it out to follow the last release (:latest). Before the first release
# exists use `main`; to pin a version use e.g. 0.1.0 or sha-1a2b3c4.
# INKROOM_TAG=main

# Copies of the database in Cloudflare R2 (ADR 0016). Cloudflare dashboard, R2: create a bucket,
# then "Manage API tokens" and a token with Object Read & Write for that bucket only.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The admin page /admin (R-064, ADR 0017): the Cloudflare Access application in front of /admin and
# /api/admin (Zero Trust, Access, Applications). Without both the page is off (404).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Who runs the service, shown on /privacy and /terms (R-096; the pages Google asks for on the OAuth
# consent screen). A name or a business name, and an e-mail where people can write about their data.
# Without them the pages say that the operator's details are still to be filled in.
OPERATOR_NAME=
CONTACT_EMAIL=

# Logs, metrics and alerts (R-098, ADR 0023, deploy/README.md section 11). The stack (Loki, Alloy,
# Prometheus, Grafana) starts only with this line; remove it to stop starting it.
# COMPOSE_PROFILES=observability
# The password of the Grafana account `admin` (required: Grafana refuses to start without it).
# A long random one: openssl rand -base64 24
# GF_SECURITY_ADMIN_PASSWORD=...
# The address of Grafana on its own hostname behind Cloudflare Access (for links in alerts).
# GRAFANA_ROOT_URL=https://logs.example.com
# The Telegram bot that gets the alerts: BotFather gives the token; the chat id is the number of
# the chat with the bot (a group gets a negative one).
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...
