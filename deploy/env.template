# Copy to .env next to docker-compose.yml on the server and fill in. Never commit the real one.

# The token of the Cloudflare tunnel (Zero Trust, Networks, Tunnels, your tunnel, "Install and
# run a connector": the long string after `--token`).
TUNNEL_TOKEN=

# The keys of the registration captcha (Cloudflare dashboard, Turnstile, a widget for your domain).
# Without TURNSTILE_SECRET registration is closed.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Which image to run. Leave it out to follow the last release (:latest). Before the first release
# exists use `main`; to pin a version use e.g. 0.1.0 or sha-1a2b3c4.
# INKROOM_TAG=main
