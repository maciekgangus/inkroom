# Copy to .env next to docker-compose.yml in this folder, on the machine of the stack. Never commit
# the real one.

# The LAN address of this machine: Loki (3100) and Prometheus (9090) are published on it only, for
# the agent on the app's machine. They have no login.
LAN_IP=192.168.0.60

# The password of the Grafana account `admin` (required: Grafana refuses to start without it).
# A long random one: openssl rand -base64 24
GF_SECURITY_ADMIN_PASSWORD=
# The address of Grafana on its own hostname behind Cloudflare Access (for links in alerts).
GRAFANA_ROOT_URL=https://logs.example.com

# The token of the tunnel of THIS machine (Zero Trust, Networks, Tunnels, a new tunnel, hostname
# logs.<domain> to http://grafana:3000). Not the token of the app's tunnel.
TUNNEL_TOKEN=

# The Telegram bot that gets the alerts: BotFather gives the token; the chat id is the number of
# the chat with the bot (a group gets a negative one).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
