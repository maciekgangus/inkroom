[Unit]
Description=Update Inkroom to the newest image
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# Set these to match the server (deploy/README.md, step 4): the user must be in the docker group and
# logged in to ghcr.io, and the folder is where deploy/ was copied to.
User=CHANGE_ME
WorkingDirectory=/opt/inkroom
ExecStart=/opt/inkroom/update.sh
