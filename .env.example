# Copy to .env (never commit .env)
PORT=8080
# Where the server listens. The local docker-compose.yml sets BIND_ADDR=0.0.0.0:8080 itself;
# with the default (all interfaces) a development switch (ADMIN_DEV_OPEN, SEED_USER_*) is
# forced to loopback or refused to start, so it cannot end up public (security audit 2026-11).
# BIND_ADDR=
